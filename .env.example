# Foxprice environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Paths ---
# OUTPUT_DIR=output
# PARTS_FILE=parts.txt
# PRICING_TIERS_FILE=pricing_tiers.csv
# WAREHOUSE_MAP_FILE=warehouse_map.csv

# --- Playwright ---
# PLAYWRIGHT_PROXY=http://user:pass@proxyhost:port
# PLAYWRIGHT_VERSION_MIN=1.55.1
# CONTEXT_POOL_SIZE=1

# --- Logging ---
# LOG_LEVEL=INFO

# --- Web panel ---
# REQUIRED: change before production, minimum 32 chars
# WEB_SECRET_KEY=change_me_32_chars_minimum_please
# WEB_PORT=8080
# WEB_ACCESS_TOKEN_TTL=900
# WEB_REFRESH_TOKEN_TTL=86400
# HAWKEYE_DIR=.
# HAWKEYE_PYTHON=python

# --- Secret backend ---
# SECRET_BACKEND=env
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=

# --- Supplier credentials (one block per supplier) ---
# SUPPLIER_A_LOGIN=your_login
# SUPPLIER_A_PASSWORD=your_password
# SUPPLIER_A_URL=https://example.com
